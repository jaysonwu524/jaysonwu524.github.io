---
import { Moon, Sun } from '@lucide/astro';
import { getLocale, messages } from '../i18n/ui';
const t = messages[getLocale(Astro.url.pathname)];
---

<button
  class="theme-toggle header-icon-button"
  type="button"
  aria-label={t.darkMode}
  aria-pressed="false"
  data-theme-toggle
  data-light-label={t.switchLight}
  data-dark-label={t.switchDark}
  hidden
>
  <Moon class="ui-icon theme-moon" aria-hidden="true" />
  <Sun class="ui-icon theme-sun" aria-hidden="true" />
</button>

<style>
  .theme-toggle[hidden] { display: none; }
  .theme-toggle { display: grid; }
  .theme-toggle .ui-icon { grid-area: 1 / 1; transition: opacity var(--transition), transform var(--transition); }
  .theme-toggle .theme-sun { opacity: 0; transform: rotate(-45deg) scale(.7); }
  .theme-toggle .theme-moon { opacity: 1; transform: rotate(0) scale(1); }
  :global(:root[data-theme='dark']) .theme-toggle .theme-sun { opacity: 1; transform: rotate(0) scale(1); }
  :global(:root[data-theme='dark']) .theme-toggle .theme-moon { opacity: 0; transform: rotate(45deg) scale(.7); }
  @media (prefers-reduced-motion: reduce) { .theme-toggle .ui-icon { transform: none !important; } }
  @media print { .theme-toggle { display: none; } }
</style>
