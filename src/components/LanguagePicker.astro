---
import { Languages, Check } from '@lucide/astro';
import { getLocale, languageNames, languageTags, localePath, locales, messages, unlocalizedPath } from '../i18n/ui';
const locale = getLocale(Astro.url.pathname);
const path = unlocalizedPath(Astro.url.pathname);
const isNotFound = /^404(?:\.html)?$/.test(path);
---

<details class="language-picker">
  <summary class="header-icon-button" aria-label={`${messages[locale].language} · ${languageNames[locale]}`} title={messages[locale].language}>
    <Languages class="ui-icon" aria-hidden="true" />
  </summary>
  <nav class="language-options" aria-label={messages[locale].language}>
    {locales.map((item) => (
      <a href={isNotFound ? (item === 'zh-cn' ? '/404.html' : localePath(item, '404')) : localePath(item, path)} lang={languageTags[item]} hreflang={languageTags[item]} aria-current={item === locale ? 'true' : undefined}>
        <span>{languageNames[item]}</span>
        {item === locale && <Check class="ui-icon" aria-hidden="true" />}
      </a>
    ))}
  </nav>
</details>

<script>
  const picker = document.querySelector<HTMLDetailsElement>('.language-picker');
  if (picker) {
    document.addEventListener('click', (event) => { if (!picker.contains(event.target as Node)) picker.open = false; });
    picker.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { picker.open = false; picker.querySelector('summary')?.focus(); }
    });
  }
</script>

<style>
  .language-picker { --language-menu-width: 172px; position: relative; flex-shrink: 0; font-size: var(--text-small); }
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .language-picker[open] summary { color: var(--accent); background: var(--surface-soft); }
  .language-options { position: absolute; right: 0; top: calc(100% + var(--space-1)); width: var(--language-menu-width); padding: var(--space-1); background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 8px 24px color-mix(in srgb, var(--ink) 8%, transparent); }
  .language-options a { display: flex; align-items: center; justify-content: space-between; gap: var(--space-1); min-height: 44px; padding: var(--space-1); color: var(--ink-soft); }
  .language-options a:hover, .language-options a[aria-current] { color: var(--accent); background: var(--surface-soft); text-decoration: none; }
  @media print { .language-picker { display: none; } }
</style>
