---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { siteRoutes } from '../i18n/content';
import { contentLocale, contentSlug } from '../i18n/ui';
import Home from '../views/Home.astro';
import Articles from '../views/Articles.astro';
import Projects from '../views/Projects.astro';
import Resume from '../views/Resume.astro';
import Article from '../views/Article.astro';
import Project from '../views/Project.astro';

export async function getStaticPaths() {
  const [routes, articles, projects] = await Promise.all([siteRoutes(), getCollection('articles'), getCollection('projects')]);
  return routes.map(({ locale, path, url }) => ({
    params: { path: url.replace(/^\/|\/$/g, '') || undefined },
    props: {
      page: path,
      article: articles.find(({ id }) => contentLocale(id) === locale && `articles/${contentSlug(id)}` === path),
      project: projects.find(({ id }) => contentLocale(id) === locale && `projects/${contentSlug(id)}` === path),
    },
  }));
}

interface Props { page: string; article?: CollectionEntry<'articles'>; project?: CollectionEntry<'projects'>; }
const { page, article, project } = Astro.props;
---
{page === '' && <Home />}
{page === 'articles' && <Articles />}
{page === 'projects' && <Projects />}
{page === 'resume' && <Resume />}
{article && <Article article={article} />}
{project && <Project project={project} />}
