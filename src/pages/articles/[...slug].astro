---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
	const articles = await getCollection('articles');
	return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<SiteLayout title={`${article.data.title} | Jayson Wu`} description={article.data.description}>
	<div class="container article-shell">
		<header class="article-header">
			<p class="eyebrow">{article.data.tags.join(' · ')}</p>
			<h1>{article.data.title}</h1>
			<p class="article-description">{article.data.description}</p>
			<p class="article-meta">{article.data.date.toLocaleDateString('zh-CN')} · {article.data.readingTime}</p>
		</header>
		<article class="article-body"><Content /></article>
	</div>
</SiteLayout>
