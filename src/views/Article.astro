---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import MoreLink from '../components/MoreLink.astro';
import ArticleList from '../components/ArticleList.astro';
import ArticleContents from '../components/ArticleContents.astro';
import { localizedCollection } from '../i18n/content';
import { getLocale, localePath, messages } from '../i18n/ui';
import { ChevronDown } from '@lucide/astro';
import '../styles/articles.css';

interface Props {
	article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = messages[locale];
const { Content, headings } = await render(article);
const outline = headings.filter((heading) => heading.depth === 2);
const articles = (await localizedCollection('articles', locale)).sort((a, b) => b.data.editorialScore - a.data.editorialScore);
const nextArticle = articles.length > 1 ? articles[(articles.findIndex((item) => item.id === article.id) + 1) % articles.length] : undefined;
---

<SiteLayout title={`${article.data.title} | Jayson Wu`} description={article.data.description}>
	<div class="container writing-shell">
		<MoreLink class="article-back" href={localePath(locale, 'articles')} back>{t.backArticles}</MoreLink>
		<header class="article-header">
			<h1>{article.data.title}</h1>
			<p class="article-description">{article.data.description}</p>
			<div class="article-meta">
				<span>{article.data.readingTime}</span>
				<span>{article.data.tags.join(' / ')}</span>
			</div>
		</header>
		{outline.length > 0 && <details class="writing-mobile-contents">
			<summary>{t.contents}<ChevronDown class="ui-icon" aria-hidden="true" focusable="false" /></summary>
			<ArticleContents headings={outline} />
		</details>}
		<div class:list={['writing-layout', { 'has-outline': outline.length > 0 }]}>
			{outline.length > 0 && <aside class="writing-outline" aria-labelledby="writing-outline-title">
				<div class="writing-outline-inner">
					<h2 id="writing-outline-title">{t.contents}</h2>
					<ArticleContents headings={outline} />
				</div>
			</aside>}
			<article class="article-body writing-body"><Content /></article>
		</div>
		<footer class="writing-end">
			{nextArticle && <section class="writing-next" aria-labelledby="writing-next-title">
				<h2 id="writing-next-title">{t.continueReading}</h2>
				<ArticleList articles={[nextArticle]} headingLevel="h3" />
			</section>}
			<MoreLink class="writing-return" href={localePath(locale, 'articles')} back>{t.backArticles}</MoreLink>
		</footer>
	</div>
</SiteLayout>
