---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import MoreLink from '../components/MoreLink.astro';
import RelatedContent from '../components/RelatedContent.astro';
import RecommendationCard from '../components/RecommendationCard.astro';
import ShareAction from '../components/ShareAction.astro';
import { localizedCollection } from '../i18n/content';
import { contentSlug, getLocale, localePath, messages } from '../i18n/ui';
import { ArrowRight } from '@lucide/astro';
import '../styles/articles.css';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = messages[locale];
const [projectName, ...projectPositioning] = project.data.title.split(/：|: /);
const flow = project.data.flow ?? [];
const { Content } = await render(project);
const allProjects = (await localizedCollection('projects', locale)).sort((a, b) => a.data.order - b.data.order);
const nextProject = allProjects[(allProjects.findIndex((item) => item.id === project.id) + 1) % allProjects.length];
const allArticles = await localizedCollection('articles', locale);
const relatedArticles = (project.data.relatedArticles ?? [])
	.map((id) => allArticles.find((article) => contentSlug(article.id) === id.trim()))
	.filter((article): article is (typeof allArticles)[number] => Boolean(article?.data.title.trim()));
---

<SiteLayout title={`${project.data.title} | Jayson Wu`} description={project.data.description}>
	<div class="container project-shell">
		<MoreLink class="article-back" href={localePath(locale, 'projects')} back>{t.backProjects}</MoreLink>
		<header class="project-header" data-reveal>
			<p class="project-kicker">{project.data.category}</p>
			<h1>{projectName}{projectPositioning.length > 0 && <span>{projectPositioning.join('：')}</span>}</h1>
			<p class="article-description">{project.data.description}</p>
			<div class="article-meta">
				<span>{project.data.tags.join(' / ')}</span>
			</div>
		</header>
		{flow.length > 0 && <section class="project-flow" aria-labelledby="project-flow-title">
			<h2 id="project-flow-title">{t.businessFlow}</h2>
			<ol>
				{flow.map((step, index) => <li><span>{step}</span>{index < flow.length - 1 && <ArrowRight class="ui-icon" aria-hidden="true" focusable="false" />}</li>)}
			</ol>
		</section>}
		<article class="article-body project-body"><Content /></article>
		<footer class:list={['content-end', 'project-followup', { 'has-related': relatedArticles.length > 0 }]}>
			<div class="content-end-grid">
				<RelatedContent id="related-articles-title" title={t.relatedArticles} links={relatedArticles.map((article) => ({ title: article.data.title, href: localePath(locale, `articles/${contentSlug(article.id)}`) }))} />
				<nav class="content-next project-next-wrap" aria-label={t.nextProject}>
					<RecommendationCard label={t.nextProject} title={nextProject.data.name.split(' · ')[0]} href={localePath(locale, `projects/${contentSlug(nextProject.id)}`)} />
				</nav>
			</div>
			<div class="content-actions">
				<ShareAction title={project.data.title} description={project.data.description} />
				<MoreLink class="content-return" href={localePath(locale, 'projects')} back>{t.backProjects}</MoreLink>
			</div>
		</footer>
	</div>
</SiteLayout>
